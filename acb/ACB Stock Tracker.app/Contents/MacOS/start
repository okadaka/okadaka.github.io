#!/bin/zsh
# start — GENERATED by tools/build-single-file.mjs inside "ACB Stock Tracker.app". Do not edit.
#
# Double-click the app in Finder. It serves this folder (dist/: acb-stock-tracker.html +
# manifest.webmanifest) over http://, opens it in Safari once the bundle is
# confirmed served, then stops the server ~10s later. No Terminal window is
# involved; the web-app manifest is fetched over http during load, which is why a
# local server is used rather than opening the file directly.
#
# Optional overrides (only when running this executable directly from a shell):
#   ACB_HOST=acbstock.local   a name mapped to 127.0.0.1 so Safari's password
#                             manager can save the password (localhost shows "(null)")
#   ACB_PORT=4173             fixed port (default 4173; reused if already running)
#   ACB_SERVE_SECONDS=10      server lifetime after opening
#
# The port is deliberately fixed: Safari's password AutoFill keys a saved password
# to "host:port", so a changing port would stop it matching. If the port is already
# serving this bundle the existing instance is reused; if another app holds it, a
# dialog asks you to free it (or set ACB_PORT).
#
# Uses Python 3 or Node.js for the local server, preferring whichever actually
# runs (so a Command Line Tools stub python3 falls through to node). If neither
# works, a dialog explains what to install. The server binds 127.0.0.1 (loopback)
# only. A launch failure is reported with a dialog.
set -e
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(dirname "$0")/../../.."

port="${ACB_PORT:-4173}"
host="${ACB_HOST:-localhost}"
serve_seconds="${ACB_SERVE_SECONDS:-10}"
LOG="/tmp/acb-stock-tracker-dist-server.log"

fail() {
  osascript -e "display dialog \"$1\" with title \"ACB Stock Tracker\" buttons {\"OK\"} default button 1" >/dev/null 2>&1 || true
}

if [ "$host" != "localhost" ] && ! dscacheutil -q host -a name "$host" 2>/dev/null | grep -q ip_address; then
  host=localhost
fi

if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
  runtime="python"
  port_is_free() {
    python3 -c 'import socket,sys;s=socket.socket();s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1);s.bind(("127.0.0.1",int(sys.argv[1])));s.close()' "$1" >/dev/null 2>&1
  }
elif command -v node >/dev/null 2>&1 && node -e 'process.exit(0)' >/dev/null 2>&1; then
  runtime="node"
  port_is_free() {
    node -e 'const n=require("net");const s=n.createServer();s.once("error",()=>process.exit(1));s.once("listening",()=>s.close(()=>process.exit(0)));s.listen(Number(process.argv[1]),"127.0.0.1");' "$1" >/dev/null 2>&1
  }
else
  fail "ACB Stock Tracker needs a working Python 3 or Node.js to run its local server. Install one (for example run \"xcode-select --install\", or \"brew install node\") and try again."
  exit 1
fi

url="http://${host}:${port}/acb-stock-tracker.html"

# The port is kept stable (no silent bumping) so Safari's password AutoFill keeps
# matching the same "host:port". If this port already serves our bundle, reuse it;
# if something else holds it, tell the user rather than changing the origin.
reuse=0
code="$(curl -s -o /dev/null -w '%{http_code}' "$url" 2>/dev/null)" || code=""
if [ "$code" = "200" ]; then
  reuse=1
elif ! port_is_free "$port"; then
  fail "Port $port is in use by another application. Close it or set ACB_PORT."
  exit 1
fi

if [ "$reuse" = "0" ]; then
  if [ "$runtime" = "python" ]; then
    SERVE_CMD=(python3 -m http.server "$port" --bind 127.0.0.1 --directory "$PWD")
  else
    SERVE_CMD=(node -e 'const http=require("http"),fs=require("fs"),p=require("path");const root=process.cwd(),port=+process.argv[1];const mime={".html":"text/html",".webmanifest":"application/manifest+json",".js":"text/javascript",".css":"text/css",".svg":"image/svg+xml",".png":"image/png",".ico":"image/x-icon"};http.createServer((q,s)=>{let u=decodeURIComponent(new URL(q.url,"http://x").pathname);if(u==="/")u="/acb-stock-tracker.html";const f=p.join(root,u.split("/").filter(Boolean).join("/"));fs.readFile(f,(e,b)=>{if(e){s.writeHead(404);return s.end("Not found");}s.writeHead(200,{"Content-Type":mime[p.extname(f)]||"application/octet-stream"});s.end(b);});}).listen(port,"127.0.0.1");' "$port")
  fi

  nohup "${SERVE_CMD[@]}" >"$LOG" 2>&1 &
  SERVER_PID=$!

  code=""
  for _ in {1..40}; do
    code="$(curl -s -o /dev/null -w '%{http_code}' "$url" 2>/dev/null)" || code=""
    if [ "$code" = "200" ]; then break; fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then break; fi
    sleep 0.25
  done

  if [ "$code" != "200" ]; then
    kill "$SERVER_PID" 2>/dev/null || true
    fail "Could not start the local server (HTTP ${code:-none}). See $LOG."
    exit 1
  fi
fi

open -a Safari "$url"

if [ "$reuse" = "0" ]; then
  ( sleep "$serve_seconds"; kill "$SERVER_PID" 2>/dev/null || true ) >/dev/null 2>&1 &
fi
exit 0
